{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toolbar",
  "description": "Floating picker toolbar: drag, events, read pick history and settings, copy",
  "windows": [
    "toolbar"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "clipboard-manager:allow-write-text"
  ]
}
